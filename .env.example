# Copy to `.env` and fill in to connect a real (test) Threads account.
# See mobile_e2e/web/README section "Connect a test Threads account".

# --- Threads app (from https://developers.facebook.com, Threads API) ---
THREADS_APP_ID=your-app-id
THREADS_API_SECRET=your-app-secret
# The redirect/callback URL registered in your Threads app:
THREADS_REDIRECT_URI=https://localhost:8080/callback

# --- Local HTTPS cert for the OAuth callback (see openssl steps below) ---
THREADS_SSL_CERT_FILEPATH=threads.crt
THREADS_SSL_KEY_FILEPATH=threads.key

# --- OpenAI (optional, for AI drafts / analyst) ---
OPENAI_API_KEY=sk-...

# openssl genpkey -algorithm RSA -out threads.key -pkeyopt rsa_keygen_bits:2048
# openssl req -new -key threads.key -out threads.csr
# openssl x509 -req -days 365 -in threads.csr -signkey threads.key -out threads.crt
